# =============================================================================
# Sinhala Fact-Checking System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys.

# --- Required ---

# Google Gemini API key (powers all AI agents)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# --- Search API keys (at least one recommended) ---

# Tavily search API key (1,000 free searches/month)
# Get yours at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Brave search API key (2,000 free searches/month)
# Get yours at: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# --- Vector Store (optional) ---

# Local Qdrant storage path (default: ./qdrant_data)
QDRANT_PATH=./qdrant_data

# Remote Qdrant instance (leave blank to use local storage)
QDRANT_URL=
QDRANT_API_KEY=
